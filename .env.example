# Copy this file to .env and fill in real values. Never commit .env.

# From https://myapi.fyers.in/dashboard -> create an app
FYERS_CLIENT_ID=XXXXX-100
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=https://127.0.0.1

# Populated by scripts/fyers_login.py after a successful login. Fyers access
# tokens expire daily, so this gets regenerated each trading day.
FYERS_ACCESS_TOKEN=

# Optional: fill in all three to enable TOTP auto-login (no manual browser
# step each day - see broker/fyers_auth.py). Leave any of them blank to keep
# using the manual browser flow. These are MORE sensitive than the app
# credentials above - your TOTP secret alone gives permanent 2FA-bypass
# capability if this file ever leaked. Never commit this file.
FYERS_USERNAME=
FYERS_TOTP_KEY=
FYERS_PIN=

# ---------------------------------------------------------------------------
# Shark Exchange (crypto and tradfi perpetuals) - https://docs.sharkexchange.in
# ---------------------------------------------------------------------------
# Requests are signed: HMAC-SHA256 over the query string (GET) or the JSON body
# (POST/PATCH/DELETE), sent as the `signature` header alongside `api-key`. The
# secret signs requests and is never transmitted - keep it out of logs.
SHARK_API_KEY=
SHARK_API_SECRET=

# ---------------------------------------------------------------------------
# Telegram alerts (optional)
# ---------------------------------------------------------------------------
# Alerts currently fire in the browser tab, so nothing is watching when it is
# closed - which does not work for a market that trades 24/7. With these set,
# alerts are delivered by the backend instead.
#
# BOT_TOKEN comes from @BotFather. CHAT_ID is the destination: message the bot
# once, then read it from https://api.telegram.org/bot<TOKEN>/getUpdates.
# The bot token is a bearer credential - anyone holding it controls the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Copy this file to .env and fill in real values. Never commit .env.

# From https://myapi.fyers.in/dashboard -> create an app
FYERS_CLIENT_ID=XXXXX-100
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=https://127.0.0.1

# Populated by scripts/fyers_login.py after a successful login. Fyers access
# tokens expire daily, so this gets regenerated each trading day.
FYERS_ACCESS_TOKEN=

# Optional: fill in all three to enable TOTP auto-login (no manual browser
# step each day - see broker/fyers_auth.py). Leave any of them blank to keep
# using the manual browser flow. These are MORE sensitive than the app
# credentials above - your TOTP secret alone gives permanent 2FA-bypass
# capability if this file ever leaked. Never commit this file.
FYERS_USERNAME=
FYERS_TOTP_KEY=
FYERS_PIN=
